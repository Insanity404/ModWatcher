# Discord bot token, from https://discord.com/developers/applications
DISCORD_TOKEN=

# Your personal feed key from https://7d2dmodding.com (Account -> API Keys). One per user.
FEED_KEY=arty_...

# Where the feed lives. The default is correct; override only for local development
# against a locally-running ArtificialInsanity.
# FEED_URL=https://7d2dmodding.com/api/feed

# Where the bot keeps its small state file (poll cursor, posted ledger, channel bindings).
# STATE_PATH=./data/state.json

# Optional custom status shown on the bot's profile.
# STATUS_TEXT=Browsing 7d2dmodding.com
