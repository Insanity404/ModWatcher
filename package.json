{
  "name": "modwatcher",
  "version": "0.1.0",
  "description": "Open-source Discord companion bot that mirrors 7d2dmodding.com mod update posts.",
  "license": "WTFPL",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "build:release": "node scripts/build-release.mjs",
    "smoke:release": "node scripts/smoke-release.mjs",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "discord.js": "^14.25.1",
    "dotenv": "^16.4.7",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.0.1",
    "prettier": "^3.5.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.24.1"
  }
}
